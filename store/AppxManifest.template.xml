<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store 打包清单模板
  用途：PWABuilder 生成 MSIX 时如果清单需要手改，用这份对照。

  三个必须和 Partner Center 对齐的字段：
    1. Identity/@Name        —— 商店分配的包标识（形如 12345ABCDE.abcdef）
    2. Identity/@Publisher   —— 必须等于签名证书 Subject，且与 Partner Center 一致
    3. Properties/DisplayName —— 商店里显示的名字

  其余按需调整。改完用 signing/sign-windows.ps1 签名。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="REPLACE_WITH_STORE_ID"
    Publisher="CN=REPLACE_WITH_PUBLISHER"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Sing Your Song</DisplayName>
    <PublisherDisplayName>zhu159666</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>哼一段旋律，自动提取音高并编成一首歌</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.10.Desktop" MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="SingYourSong.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Sing Your Song"
        Description="哼唱编曲工作台"
        BackgroundColor="#0a0e14"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\LargeTile.png"
          ShortName="Sing Your Song" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0a0e14" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <!-- 麦克风：需要用户在系统设置里授权，商店审核会看这一条 -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>

{
  "id": "/sing-your-song/",
  "name": "Sing Your Song · Hum Arranger",
  "short_name": "Sing Your Song",
  "description": "Hum a melody, get an arrangement you can edit. Multi-track, mixing, chords, drums — export WAV/MIDI. Everything stays on your device.",
  "lang": "zh-CN",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "landscape",
  "background_color": "#0a0e14",
  "theme_color": "#0a0e14",
  "categories": [
    "music",
    "productivity",
    "utilities"
  ],
